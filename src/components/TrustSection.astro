---
/*
  Logos are pre-rendered white PNGs (public/images/partners/*-white.png),
  not colour logos whitened with a CSS filter: Samsung Internet's dark mode
  overrides CSS filters on images, which turned the strip dark on Galaxy
  phones. Baked-in white survives it (as the white navbar logo always has).
  w/h are the files' intrinsic size, so the browser reserves the right space.
*/
const partners = [
  { src: 'innovasjon-norge-white.png', alt: 'Innovasjon Norge',          w: 330, h: 132, height: 44 },
  { src: 'hydro-white.png',            alt: 'Hydro Aluminium',           w: 132, h: 132, height: 44 },
  { src: 'elkem-white.png',            alt: 'Elkem',                     w: 413, h: 132, height: 38 },
  { src: 'eramet-white.png',           alt: 'Eramet',                    w: 268, h: 132, height: 38 },
  { src: 'uis-white.png',              alt: 'Universitetet i Stavanger', w: 290, h: 132, height: 44 },
];
---
<!-- Quiet trust strip directly below hero — monochrome partner logos -->
<section data-animate class="border-y border-white/[0.06] py-12">
  <div class="mx-auto flex max-w-[1180px] flex-col items-center gap-9 px-6">

    <p class="m-0 text-[0.68rem] font-semibold uppercase tracking-[0.3em] text-white/35">
      <span data-i18n="no">Med tillit fra</span><span data-i18n="en">Trusted by</span>
    </p>

    <div class="flex flex-wrap items-center justify-center gap-x-[clamp(32px,5vw,72px)] gap-y-8">
      {partners.map(({ src, alt, w, h, height }) => (
        <img
          src={`/images/partners/${src}`}
          alt={alt}
          width={w}
          height={h}
          loading="lazy"
          style={`height:${height}px;`}
          class="w-auto opacity-45 transition-opacity duration-300 hover:opacity-90"
        />
      ))}
    </div>

  </div>
</section>
