---
/*
  «Utfordringen» — why industry isn't wireless yet, in three steps:
  cabling costs millions → but wireless sensors run on batteries → the
  energy is already there (Eldion). Sits between the hero (what) and
  «Vår løsning» (how).

  Deliberately restrained: no icons, no cards, no glow. Three columns split
  by hairlines, big figures straight on the background. Skim path:
  H2 → step headings → figures. Orange appears only on the step-3 figure.

  Desktop columns are a CSS subgrid, so step headings share one row and the
  figures start on the same line even when a heading wraps.

  Figures are static HTML (no counter animation) so crawlers, link previews
  and slow phones always see the real values. Footnote marks link to the
  «Kilder og noter» block above the footer (SourcesSection).
*/

const ref = (n: number) =>
  `<sup class="ml-0.5"><a href="#kilde-${n}" class="text-brand-sky no-underline transition-colors duration-250 hover:text-brand-white">${n}</a></sup>`;

const steps = [
  {
    headingNo: 'Kabling koster millioner',
    headingEn: 'Cabling costs millions',
    /* no-break spaces keep the figures from splitting into odd fragments */
    figureNo: '&gt;&nbsp;1&nbsp;mill.&nbsp;USD',
    figureEn: '&gt;&nbsp;USD 1&nbsp;million',
    labelNo: `beregnet besparelse på én offshoreinstallasjon, med hvert sjette målepunkt trådløst${ref(1)}`,
    labelEn: `calculated savings on one offshore platform, with one in six measurement points wireless${ref(1)}`,
    textNo: `I tillegg opptil 35 tonn mindre kabel og utstyr.${ref(1)} Et kablet målepunkt kan ta dager å installere, mot et par timer for trådløst.${ref(2)}`,
    textEn: `Plus up to 35 tonnes less cable and equipment.${ref(1)} A wired measurement point can take days to install, versus a couple of hours for wireless.${ref(2)}`,
  },
  {
    headingNo: 'Men trådløse sensorer går på batteri',
    headingEn: 'But wireless sensors run on batteries',
    figureNo: 'Batteribytte hver&nbsp;dag',
    figureEn: 'Daily battery changes',
    labelNo: 'ved 1&nbsp;000 sensorer på tre års batterilevetid',
    labelEn: 'with 1,000 sensors and a three-year battery life',
    textNo: 'Vedlikeholdet du ville slippe, kommer tilbake. Og for å spare strøm sender sensorene data sjelden.',
    textEn: 'The maintenance you wanted to avoid comes back. And to save power, the sensors transmit data rarely.',
  },
  {
    headingNo: 'Energien er allerede der',
    headingEn: 'The energy is already there',
    figureNo: '20–50&nbsp;%',
    figureEn: '20–50&nbsp;%',
    labelNo: `av industriens energi går tapt som spillvarme${ref(3)}`,
    labelEn: `of industrial energy is lost as waste heat${ref(3)}`,
    textNo: 'Eldion gjør spillvarmen om til strøm, så sensoren slipper batteri og kan sende data oftere.',
    textEn: 'Eldion turns the waste heat into electricity, so the sensor needs no battery and can transmit data often.',
    accent: true,
    link: true,
  },
];
---
<section id="hvorfor" class="bg-brand-navy-3 px-4 py-32 md:px-[5vw] max-[768px]:py-24">
  <div class="mx-auto max-w-[980px]">

    <p data-animate class="mb-4 text-[0.72rem] font-semibold uppercase tracking-[0.26em] text-brand-sky">
      <span data-i18n="no">Utfordringen</span><span data-i18n="en">The challenge</span>
    </p>
    <h2 data-animate class="m-0 mb-16 text-balance font-display text-[clamp(1.9rem,3.4vw,2.8rem)] font-bold leading-[1.1] tracking-[-0.02em] text-brand-white max-[768px]:mb-12">
      <span data-i18n="no">Hvorfor er ikke industrien trådløs allerede?</span><span data-i18n="en">Why isn’t industry wireless already?</span>
    </h2>

    <!-- Three steps: stacked with hairlines on mobile, hairline-split columns from lg -->
    <div data-animate
         class="grid grid-cols-1 divide-y divide-white/[0.08]
                lg:grid-cols-3 lg:grid-rows-[auto_auto] lg:gap-y-5 lg:divide-x lg:divide-y-0">
      {steps.map((s) => (
        <div class="py-9 first:pt-0 last:pb-0
                    lg:row-span-2 lg:grid lg:grid-rows-subgrid lg:px-10 lg:py-0 lg:first:pl-0 lg:last:pr-0">
          <h3 class="m-0 mb-5 font-display text-[1.02rem] font-semibold leading-snug tracking-[-0.005em] text-white/90 lg:mb-0">
            <span data-i18n="no">{s.headingNo}</span><span data-i18n="en">{s.headingEn}</span>
          </h3>

          <div>
            <p class:list={[
              'm-0 font-display text-[clamp(2rem,3.1vw,2.55rem)] font-bold leading-[1.08] tracking-[-0.02em]',
              s.accent ? 'text-brand-orange' : 'text-brand-white',
            ]}>
              <span data-i18n="no" set:html={s.figureNo} /><span data-i18n="en" set:html={s.figureEn} />
            </p>
            <p class="m-0 mt-3 text-[0.68rem] uppercase leading-snug tracking-[0.16em] text-white/55">
              <span data-i18n="no" set:html={s.labelNo} /><span data-i18n="en" set:html={s.labelEn} />
            </p>
            <p class="m-0 mt-5 text-[0.94rem] leading-[1.7] text-white/65">
              <span data-i18n="no" set:html={s.textNo} /><span data-i18n="en" set:html={s.textEn} />
            </p>
            {s.link && (
              <a
                href="#goal"
                class="mt-6 inline-flex items-center gap-1.5 text-[0.88rem] font-semibold text-brand-sky no-underline
                       transition-colors duration-250 hover:text-brand-white"
              >
                <span data-i18n="no">Se hvordan det fungerer</span><span data-i18n="en">See how it works</span>
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
