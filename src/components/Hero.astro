---
---
<div id="home" style="scroll-margin-top: 0;">
  <section class="relative flex min-h-screen flex-col justify-center overflow-hidden
                  px-[8vw] max-[768px]:px-6 max-[768px]:justify-end max-[768px]:pb-24">

    <!-- ── Background: flat navy + engineering grid + single soft glow ── -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <!-- subtle engineering grid, faded at edges -->
      <div class="absolute inset-0"
           style="background-image:
                    linear-gradient(rgba(242,241,241,0.025) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(242,241,241,0.025) 1px, transparent 1px);
                  background-size: 56px 56px;
                  mask-image: radial-gradient(ellipse 90% 80% at 50% 45%, black 30%, transparent 78%);
                  -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 45%, black 30%, transparent 78%);">
      </div>
      <!-- one restrained blue glow, top right -->
      <div class="absolute inset-0"
           style="background: radial-gradient(ellipse 46% 52% at 78% 22%, rgba(10,111,182,0.20) 0%, transparent 70%);">
      </div>
      <!-- logomark bolt as faint watermark, right edge -->
      <img
        src="/images/brand/logomark.svg"
        alt=""
        class="absolute top-1/2 -translate-y-1/2 select-none max-[900px]:hidden"
        style="right:-14vh; height:112vh; width:auto; opacity:0.05;
               filter: brightness(0) invert(1);"
      />
    </div>

    <div class="relative">
      <!-- Overline -->
      <p class="hero-pre mb-7 text-[0.75rem] font-semibold uppercase tracking-[0.26em] text-brand-sky max-[768px]:mb-5">
        <span data-i18n="no">Batteriløs industriell IoT</span><span data-i18n="en">Battery-free industrial IoT</span>
      </p>

      <!-- Headline — Inter Tight, heavy, tight -->
      <h1 class="hero-heading m-0 font-display font-bold leading-[1.04] tracking-[-0.03em] text-brand-white
                 text-[clamp(2.6rem,5.6vw,4.6rem)] max-w-[720px] max-[768px]:max-w-none">
        <span class="hero-line-wrap"><span class="hero-line"><span data-i18n="no">Vi gjør</span><span data-i18n="en">We make</span></span></span>
        <span class="hero-line-wrap"><span class="hero-line"><span data-i18n="no">industrien</span><span data-i18n="en">industry</span></span></span>
        <span class="hero-line-wrap"><span class="hero-line"><span data-i18n="no">trådløs.</span><span data-i18n="en">wireless.</span></span></span>
      </h1>

      <!-- Subtitle -->
      <div class="hero-sub mt-8 max-w-[520px] max-[768px]:mt-6 max-[768px]:max-w-none">
        <p class="m-0 text-[clamp(1.02rem,1.5vw,1.3rem)] leading-[1.65] text-white/60">
          <span data-i18n="no">Trådløs data drevet av spillvarme.</span><span data-i18n="en">Wireless data powered by waste heat.</span>
        </p>
        <p class="hero-gradient-text m-0 text-[clamp(1.02rem,1.5vw,1.3rem)] font-semibold leading-[1.65]">
          <span data-i18n="no">Ingen batterier. Ingen kabler.</span><span data-i18n="en">No batteries. No cables.</span>
        </p>
      </div>

      <!-- CTAs -->
      <div class="hero-cta mt-11 flex flex-wrap items-center gap-4 max-[768px]:mt-9">
        <a
          href="#contact"
          class="inline-flex items-center gap-2.5 rounded-lg bg-brand-orange px-7 py-[15px]
                 text-[0.95rem] font-semibold text-white no-underline
                 transition-all duration-250
                 hover:bg-brand-orange-deep hover:-translate-y-0.5
                 hover:shadow-[0_10px_28px_rgba(234,113,19,0.30)]"
        >
          <span data-i18n="no">Kontakt oss</span><span data-i18n="en">Contact us</span>
          <i data-lucide="arrow-right" class="h-4 w-4"></i>
        </a>
        <a
          href="#goal"
          class="inline-flex items-center gap-2.5 rounded-lg border border-white/16 px-7 py-[15px]
                 text-[0.95rem] font-semibold text-white/80 no-underline
                 transition-all duration-250
                 hover:border-white/40 hover:bg-white/[0.03] hover:text-white"
        >
          <span data-i18n="no">Se løsningen</span><span data-i18n="en">See the solution</span>
        </a>
      </div>
    </div>

    <!-- Scroll cue -->
    <div aria-hidden="true"
         class="absolute bottom-9 left-1/2 -translate-x-1/2 max-[768px]:hidden">
      <div class="h-11 w-px overflow-hidden bg-white/10">
        <div class="hero-scroll-cue h-1/3 w-full bg-brand-sky/80"></div>
      </div>
    </div>

  </section>
</div>

<style>
  .hero-scroll-cue {
    animation: scrollCue 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes scrollCue {
    0%   { transform: translateY(-100%); }
    60%  { transform: translateY(300%); }
    100% { transform: translateY(300%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-cue { animation: none; }
  }
</style>
