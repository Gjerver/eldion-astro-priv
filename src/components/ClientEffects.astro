<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const isReduced = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  const isTouch   = window.matchMedia('(hover:none) and (pointer:coarse)').matches;

  /* ══════════════════════════════════════════════════════════════
     1. INITIAL HIDE – all GSAP-owned elements start invisible
     ══════════════════════════════════════════════════════════════ */
  gsap.set('.gsap-card', { opacity: 0, y: 32 });

  /* ══════════════════════════════════════════════════════════════
     2. HERO TEXT REVEAL  (load-time, not scroll)
        CSS sets initial hidden state; GSAP animates to visible
     ══════════════════════════════════════════════════════════════ */
  if (!isReduced) {
    const heroTl = gsap.timeline({ delay: 0.22 });
    heroTl
      .to('.hero-pre',  { opacity: 1, duration: 0.6,  ease: 'power3.out' })
      .to('.hero-line', { y: 0,       duration: 1.05, stagger: 0.13, ease: 'power4.out' }, '-=0.3')
      .to('.hero-sub',  { opacity: 1, duration: 0.72, ease: 'power3.out' }, '-=0.5')
      .to('.hero-cta',  { opacity: 1, duration: 0.6,  ease: 'power3.out' }, '-=0.42');
  } else {
    gsap.set('.hero-line', { y: 0 });
    gsap.set('.hero-pre, .hero-sub, .hero-cta', { opacity: 1 });
  }

  /* ══════════════════════════════════════════════════════════════
     3. SCROLL ANIMATIONS
     ══════════════════════════════════════════════════════════════ */
  if (!isReduced) {

    /* Bento tiles – staggered fade-in-up */
    ScrollTrigger.batch('.gsap-card', {
      onEnter: (els) => gsap.to(els, {
        opacity: 1, y: 0,
        duration: 0.65, stagger: 0.1,
        ease: 'power3.out',
      }),
      once:  true,
      start: 'top 88%',
    });

    /* ── GSAP counter for stats (counts up from 0 on scroll) ─── */
    document.querySelectorAll<HTMLElement>('.counter-el').forEach((el) => {
      const target = parseInt(el.dataset.target ?? '0', 10);
      const suffix = el.dataset.suffix ?? '';
      const obj    = { val: 0 };

      ScrollTrigger.create({
        trigger: el,
        start:   'top 85%',
        once:    true,
        onEnter: () => {
          gsap.to(obj, {
            val:      target,
            duration: 2,
            ease:     'power2.out',
            onUpdate: () => {
              el.textContent = Math.round(obj.val).toLocaleString('nb-NO') + suffix;
            },
          });
        },
      });
    });

  } else {
    gsap.set('.gsap-card', { opacity: 1, y: 0 });
  }

  /* ══════════════════════════════════════════════════════════════
     4b. TEAM IMAGES – colour on scroll-into-view (touch/mobile)
         On desktop, CSS group-hover handles grayscale→colour.
         On touch devices hover never fires, so we use
         IntersectionObserver: visible card → full colour,
         out-of-view → grey. CSS transition makes it smooth.
     ══════════════════════════════════════════════════════════════ */
  if (isTouch) {
    const teamObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const img = entry.target as HTMLElement;
          img.style.filter = entry.isIntersecting
            ? 'grayscale(0%)'
            : 'grayscale(100%)';
        });
      },
      { threshold: 0.45, rootMargin: '-8% 0px -8% 0px' }
    );

    document.querySelectorAll<HTMLElement>('.team-img').forEach((img) => {
      teamObs.observe(img);
    });
  }

  /* ══════════════════════════════════════════════════════════════
     5. 3-D TILT ON SOLUTION IMAGES
     ══════════════════════════════════════════════════════════════ */
  if (!isTouch) {
    document.querySelectorAll<HTMLElement>('.tilt-img').forEach((img) => {
      img.style.transformStyle = 'preserve-3d';
      img.style.willChange     = 'transform';
      img.style.transition     = 'box-shadow 0.3s ease';

      img.addEventListener('mousemove', (e: MouseEvent) => {
        const r = img.getBoundingClientRect();
        const x = ((e.clientX - r.left)  / r.width  - 0.5) * 24;
        const y = ((e.clientY - r.top)   / r.height - 0.5) * -24;
        gsap.to(img, {
          rotateX: y, rotateY: x,
          transformPerspective: 700,
          duration: 0.28, ease: 'power2.out',
          boxShadow: `${-x * 0.4}px ${y * 0.4}px 30px rgba(0,174,239,0.2)`,
        });
      });

      img.addEventListener('mouseleave', () => {
        gsap.to(img, {
          rotateX: 0, rotateY: 0,
          boxShadow: 'none',
          duration: 0.55, ease: 'elastic.out(1,0.32)',
        });
      });
    });
  }

  /* ══════════════════════════════════════════════════════════════
     6. PARALLAX ON PRODUCT IMAGES
     ══════════════════════════════════════════════════════════════ */
  if (!isReduced) {
    document.querySelectorAll<HTMLElement>('.parallax-img').forEach((img) => {
      gsap.fromTo(img,
        { y: 55 },
        {
          y: -55,
          ease: 'none',
          scrollTrigger: { trigger: img, start: 'top bottom', end: 'bottom top', scrub: 1 },
        }
      );
    });
  }

  /* ══════════════════════════════════════════════════════════════
     7. MAGNETIC BUTTONS
     ══════════════════════════════════════════════════════════════ */
  if (!isTouch) {
    document.querySelectorAll<HTMLElement>('.magnetic').forEach((btn) => {
      btn.style.willChange = 'transform';

      btn.addEventListener('mousemove', (e: MouseEvent) => {
        const r  = btn.getBoundingClientRect();
        const dx = e.clientX - r.left - r.width  / 2;
        const dy = e.clientY - r.top  - r.height / 2;
        gsap.to(btn, { x: dx * 0.38, y: dy * 0.38, duration: 0.26, ease: 'power2.out' });
      });

      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.55, ease: 'elastic.out(1,0.35)' });
      });
    });
  }

  /* ══════════════════════════════════════════════════════════════
     8. DECRYPT / SCRAMBLE TEXT
        Usage: add data-decrypt to any element
     ══════════════════════════════════════════════════════════════ */
  const GLYPHS = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!@#$%^&*+=?><';

  function scramble(el: HTMLElement, original: string, ms = 860) {
    const start = Date.now();
    const id = setInterval(() => {
      const elapsed  = Date.now() - start;
      const progress = Math.min(elapsed / ms, 1);
      const locked   = Math.floor(progress * original.length);

      el.textContent = original
        .split('')
        .map((ch, i) => {
          if (ch === ' ') return ' ';
          return i < locked ? ch : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
        })
        .join('');

      if (progress >= 1) { el.textContent = original; clearInterval(id); }
    }, 28);
  }

  const decryptObs = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const original = el.dataset.decrypt ?? el.textContent ?? '';
      el.dataset.decrypt = original;
      scramble(el, original);
      decryptObs.unobserve(el);
    });
  }, { threshold: 0.6 });

  document.querySelectorAll<HTMLElement>('[data-decrypt]').forEach((el) => {
    el.dataset.decrypt = el.textContent ?? '';
    decryptObs.observe(el);
  });

  /* ══════════════════════════════════════════════════════════════
     9. LANGUAGE SWITCH — scramble transition NO ↔ EN
        Current language dissolves into noise, language flips, the new
        language resolves out of noise. Operates on text nodes only, so
        inline markup (<strong>, <br>) is preserved. Viewport-filtered
        for performance; reuses GLYPHS + decryptObs from section 8.
     ══════════════════════════════════════════════════════════════ */
  {
    const root = document.documentElement;

    function applyLang(lang: string) {
      root.setAttribute('data-lang', lang);
      root.setAttribute('lang', lang);
      document.querySelectorAll<HTMLElement>('[data-ph-no]').forEach((el) => {
        const v = lang === 'en' ? el.dataset.phEn : el.dataset.phNo;
        if (v != null) (el as HTMLInputElement).placeholder = v;
      });
      document.querySelectorAll<HTMLElement>('[data-opt-no]').forEach((el) => {
        const v = lang === 'en' ? el.dataset.optEn : el.dataset.optNo;
        if (v != null) el.textContent = v;
      });
    }

    const inView = (el: Element) => {
      const r = el.getBoundingClientRect();
      return r.bottom > 0 && r.top < window.innerHeight && r.right > 0 && r.left < window.innerWidth;
    };

    interface TextTarget { node: Text; text: string; }
    function collectTargets(els: Element[]): TextTarget[] {
      const out: TextTarget[] = [];
      els.forEach((el) => {
        const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        let n: Node | null;
        while ((n = w.nextNode())) {
          const t = n.nodeValue ?? '';
          if (t.trim().length) out.push({ node: n as Text, text: t });
        }
      });
      return out;
    }

    function paint(targets: TextTarget[], lockFrac: number) {
      const f = lockFrac < 0 ? 0 : lockFrac > 1 ? 1 : lockFrac;
      for (const t of targets) {
        const s = t.text;
        const locked = Math.floor(f * s.length);
        let o = '';
        for (let i = 0; i < s.length; i++) {
          const ch = s[i];
          const code = s.charCodeAt(i);
          /* preserve all whitespace incl. tab/newline/non-breaking space */
          if (code === 32 || code === 9 || code === 10 || code === 160) { o += ch; continue; }
          o += i < locked ? ch : GLYPHS[(Math.random() * GLYPHS.length) | 0];
        }
        t.node.nodeValue = o;
      }
    }
    const restore = (targets: TextTarget[]) => { for (const t of targets) t.node.nodeValue = t.text; };

    let busy = false;
    const OUT_MS = 120, IN_MS = 240;

    function switchLang(lang: string) {
      const cur = root.getAttribute('data-lang') || 'no';
      if (lang === cur || busy) return;

      if (isReduced) { applyLang(lang); return; }

      busy = true;
      const outTargets = collectTargets(
        Array.from(document.querySelectorAll(`[data-i18n="${cur}"]`)).filter(inView)
      );

      const t0 = performance.now();
      function out(now: number) {
        const p = (now - t0) / OUT_MS;
        if (p < 1) { paint(outTargets, 1 - p); requestAnimationFrame(out); return; }

        restore(outTargets);
        applyLang(lang);

        const inEls = Array.from(document.querySelectorAll(`[data-i18n="${lang}"]`)).filter(inView);
        /* avoid double-scramble: take over any decrypt spans we're animating */
        inEls.forEach((el) => { if (el.hasAttribute('data-decrypt')) decryptObs.unobserve(el); });
        const inTargets = collectTargets(inEls);

        const t1 = performance.now();
        function inn(now2: number) {
          const q = (now2 - t1) / IN_MS;
          if (q < 1) { paint(inTargets, q); requestAnimationFrame(inn); return; }
          restore(inTargets);
          busy = false;
        }
        requestAnimationFrame(inn);
      }
      requestAnimationFrame(out);
    }

    document.querySelectorAll<HTMLElement>('[data-set-lang]').forEach((btn) => {
      btn.addEventListener('click', () => switchLang(btn.dataset.setLang ?? 'no'));
    });
  }
</script>
