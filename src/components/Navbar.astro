---
import LanguageSwitcher from './LanguageSwitcher.astro';

const links = [
  { href: '#goal', no: 'Løsningen', en: 'Solution' },
  { href: '#team', no: 'Om oss',    en: 'About us' },
  { href: '#news', no: 'Nyheter',   en: 'News' },
];
---
<header
  id="site-header"
  class="fixed top-0 w-full z-50 box-border
         border-b border-transparent
         transition-all duration-300"
>
  <div class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-y-2
              px-[clamp(16px,4vw,48px)] py-[18px] transition-all duration-300
              max-[900px]:flex-col max-[900px]:items-center"
       id="site-header-inner">

    <a href="#home" class="flex-none" aria-label="Eldion – til toppen">
      <img
        id="nav-logo"
        src="/images/brand/logo-white.png"
        alt="Eldion"
        style="width:132px;height:auto;transition:width 0.3s ease;"
      />
    </a>

    <div class="flex items-center gap-[clamp(14px,2.4vw,36px)]
                max-[900px]:mt-1 max-[900px]:flex-wrap max-[900px]:justify-center">
      <nav class="flex items-center gap-[clamp(14px,2.2vw,32px)] max-[900px]:flex-wrap max-[900px]:justify-center">
        {links.map(({ href, no, en }) => (
          <a
            href={href}
            class="relative text-[0.9rem] font-medium text-white/65 no-underline whitespace-nowrap
                   transition-colors duration-200 hover:text-white
                   after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0
                   after:bg-brand-sky after:transition-all after:duration-300 hover:after:w-full
                   focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-sky
                   focus-visible:outline-offset-4 focus-visible:rounded-sm"
          >
            <span data-i18n="no">{no}</span><span data-i18n="en">{en}</span>
          </a>
        ))}
      </nav>

      <a
        href="#contact"
        class="inline-flex items-center whitespace-nowrap rounded-lg bg-brand-orange
               px-5 py-[9px] text-[0.88rem] font-semibold text-white no-underline
               transition-all duration-250
               hover:bg-brand-orange-deep hover:-translate-y-px
               hover:shadow-[0_6px_20px_rgba(234,113,19,0.28)]"
      >
        <span data-i18n="no">Kontakt oss</span><span data-i18n="en">Contact us</span>
      </a>

      <LanguageSwitcher />
    </div>
  </div>
</header>

<script>
  const hdr  = document.getElementById('site-header')       as HTMLElement | null;
  const innr = document.getElementById('site-header-inner') as HTMLElement | null;
  const logo = document.getElementById('nav-logo')          as HTMLImageElement | null;

  function updateNav() {
    if (!hdr || !innr || !logo) return;
    const scrolled = window.scrollY > 40;
    hdr.style.backgroundColor  = scrolled ? 'rgba(0,23,40,0.88)'        : '';
    hdr.style.backdropFilter   = scrolled ? 'blur(12px)'                : '';
    hdr.style.borderBottomColor = scrolled ? 'rgba(255,255,255,0.08)'   : 'transparent';
    innr.style.paddingTop      = scrolled ? '11px' : '';
    innr.style.paddingBottom   = scrolled ? '11px' : '';
    logo.style.width           = scrolled ? '112px' : '132px';
  }

  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav();
</script>
