---
const topics = [
  { value: 'investering',      no: 'Investering',        en: 'Investment' },
  { value: 'samarbeid',        no: 'Samarbeid',          en: 'Partnership' },
  { value: 'pilotprosjekt',    no: 'Pilotprosjekt',      en: 'Pilot project' },
  { value: 'kundeforespørsel', no: 'Kundeforespørsel',   en: 'Customer enquiry' },
  { value: 'teknisk',          no: 'Teknisk henvendelse', en: 'Technical enquiry' },
  { value: 'annet',            no: 'Annet',              en: 'Other' },
];

const inputClasses = `w-full box-border rounded-lg border border-white/10 bg-white/[0.05]
  px-4 py-3.5 text-[0.95rem] text-white placeholder:text-white/30
  transition-colors duration-200
  focus:border-brand-sky focus:bg-white/[0.07] focus:outline-none
  aria-invalid:border-red-400/60`;
---
<section id="contact" class="mx-auto max-w-[720px] px-5 pb-16 pt-28 max-[900px]:pt-[170px]">

  <!-- Header — same rhythm as the other sections -->
  <p data-animate class="mb-4 text-[0.72rem] font-semibold uppercase tracking-[0.26em] text-brand-sky">
    <span data-i18n="no">Kontakt</span><span data-i18n="en">Contact</span>
  </p>
  <h2 data-animate class="m-0 mb-5 font-display text-[clamp(1.9rem,3.4vw,2.8rem)] font-bold leading-[1.1] tracking-[-0.02em] text-brand-white">
    <span data-i18n="no">Snakk med oss</span><span data-i18n="en">Talk to us</span>
  </h2>
  <p data-animate data-delay="1" class="mb-12 max-w-[520px] text-[1.02rem] leading-[1.7] text-white/55">
    <span data-i18n="no">Vi vil gjerne høre fra deg – enten du har spørsmål, forslag eller ønsker samarbeid.</span><span data-i18n="en">We'd love to hear from you — whether you have questions, ideas or want to collaborate.</span>
  </p>

  <!-- Form-level error (shown by @formspree/ajax on submission failure) -->
  <div data-fs-error
       class="hidden mb-6 rounded-lg border border-red-400/25 bg-red-500/10
              px-4 py-3 text-left text-sm text-red-300">
  </div>

  <!-- Success message (shown by @formspree/ajax on success) -->
  <div data-fs-success
       class="hidden mb-6 rounded-xl border border-white/10 bg-brand-navy-2
              px-6 py-12 text-center">
    <div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-brand-orange/15">
      <span class="text-2xl font-bold text-brand-orange">✓</span>
    </div>
    <p class="m-0 mb-2 font-display text-xl font-semibold text-white">
      <span data-i18n="no">Takk for meldingen!</span><span data-i18n="en">Thank you for your message!</span>
    </p>
    <p class="m-0 text-sm text-white/55">
      <span data-i18n="no">Vi tar kontakt med deg så snart som mulig.</span><span data-i18n="en">We'll get back to you as soon as possible.</span>
    </p>
  </div>

  <form
    id="contact-form"
    data-animate
    data-delay="2"
    class="flex flex-col gap-6 rounded-xl border border-white/[0.08] bg-brand-navy-2
           p-9 shadow-[0_16px_48px_rgba(0,0,0,0.28)] max-[600px]:p-6"
  >
    <div>
      <label for="topic" class="mb-2 block text-left text-[0.78rem] font-semibold uppercase tracking-[0.12em] text-white/55">
        <span data-i18n="no">Hva gjelder det?</span><span data-i18n="en">What is it about?</span>
      </label>
      <select id="topic" name="topic" required data-fs-field
              class={`${inputClasses} [&>option]:bg-white [&>option]:text-brand-navy`}>
        <option value="" data-opt-no="Velg kategori" data-opt-en="Select a category">Velg kategori</option>
        {topics.map(({ value, no, en }) => (
          <option value={value} data-opt-no={no} data-opt-en={en}>{no}</option>
        ))}
      </select>
      <span data-fs-error="topic" class="mt-1.5 block text-left text-xs text-red-300"></span>
    </div>

    <div>
      <label for="name" class="mb-2 block text-left text-[0.78rem] font-semibold uppercase tracking-[0.12em] text-white/55">
        <span data-i18n="no">Hvem er du?</span><span data-i18n="en">Who are you?</span>
      </label>
      <input
        type="text" id="name" name="name"
        placeholder="Navn eller firmanavn" data-ph-no="Navn eller firmanavn" data-ph-en="Name or company name"
        required data-fs-field
        class={inputClasses}
      />
      <span data-fs-error="name" class="mt-1.5 block text-left text-xs text-red-300"></span>
    </div>

    <div>
      <label for="email" class="mb-2 block text-left text-[0.78rem] font-semibold uppercase tracking-[0.12em] text-white/55">
        <span data-i18n="no">E-post</span><span data-i18n="en">Email</span>
      </label>
      <input
        type="email" id="email" name="email"
        placeholder="Din e-postadresse" data-ph-no="Din e-postadresse" data-ph-en="Your email address"
        required data-fs-field
        class={inputClasses}
      />
      <span data-fs-error="email" class="mt-1.5 block text-left text-xs text-red-300"></span>
    </div>

    <div>
      <label for="message" class="mb-2 block text-left text-[0.78rem] font-semibold uppercase tracking-[0.12em] text-white/55">
        <span data-i18n="no">Melding</span><span data-i18n="en">Message</span>
      </label>
      <textarea
        id="message" name="message"
        placeholder="Skriv meldingen din her..." data-ph-no="Skriv meldingen din her..." data-ph-en="Write your message here..."
        required data-fs-field
        class={`${inputClasses} h-[130px] resize-none`}
      ></textarea>
      <span data-fs-error="message" class="mt-1.5 block text-left text-xs text-red-300"></span>
    </div>

    <button
      type="submit"
      data-fs-submit-btn
      class="mt-1 cursor-pointer rounded-lg border-none bg-brand-orange py-4
             text-[1rem] font-semibold text-white
             transition-all duration-250
             hover:bg-brand-orange-deep hover:-translate-y-px
             hover:shadow-[0_10px_28px_rgba(234,113,19,0.28)]
             disabled:cursor-not-allowed disabled:opacity-50 disabled:translate-y-0 disabled:shadow-none"
    >
      <span data-i18n="no">Send melding</span><span data-i18n="en">Send message</span>
    </button>
  </form>

  <p class="mt-10 text-center text-[0.95rem] text-white/45">
    <span data-i18n="no">Du kan også nå oss på telefon:</span><span data-i18n="en">You can also reach us by phone:</span>
    <a href="tel:+4748204754" class="font-semibold text-brand-sky no-underline hover:underline">(+47) 482 04 754</a>
  </p>

</section>

<script>
  import { initForm } from '@formspree/ajax';

  initForm({ formElement: '#contact-form', formId: 'xzzknewz' });
</script>
